<%= form_with(model: task, html: { class: "p-4 rounded shadow", style: "background-color: #f8f9fa;" }) do |form| %>
  <% if task.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(task.errors.count, "erro") %> impediram o salvamento da task:</h4>
      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :tittle, class: "form-label" %>
    <%= form.text_field :tittle, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_field :description, class: "form-control" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :status, class: "form-label" %>
      <%= form.select :status, options_for_select([['To Do', 'To Do'], ['Doing', 'Doing'], ['Done', 'Done']]), {}, class: "form-select" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :priority, class: "form-label" %>
      <%= form.select :priority, options_for_select([['Low', 1], ['Medium', 2], ['High', 3]]), {}, class: "form-select" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :assignee, class: "form-label" %>
    <%= form.text_field :assignee, class: "form-control" %>
  </div>

  <div class="text-end">
    <%= form.submit "Salvar Task", class: "btn btn-primary px-4" %>
  </div>
<% end %>
